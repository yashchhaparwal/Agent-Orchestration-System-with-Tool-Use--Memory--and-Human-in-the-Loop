# Copy to .env and fill in. Every default chain in config/models.yaml uses only free providers.

# --- LLM: free providers ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OLLAMA_BASE_URL=http://localhost:11434/v1
TOKENROUTER_FREE_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# --- LLM: optional paid providers (off by default; their chain entries are dropped while false) ---
ENABLE_PAID_PROVIDERS=false
TOKENROUTER_API_KEY=
ANTHROPIC_API_KEY=
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1

# --- stores ---
DATABASE_URL=postgresql+psycopg://foreman:foreman@localhost:5432/foreman
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=foreman

# --- tools ---
WORKSPACE_ROOT=./data/workspace
SANDBOX_IMAGE=foreman-sandbox:latest
MCP_WEB_URL=http://localhost:7001/mcp
MCP_FILES_URL=http://localhost:7002/mcp
MCP_SANDBOX_URL=http://localhost:7003/mcp
MCP_DB_URL=http://localhost:7004/mcp
MCP_ACTIONS_URL=http://localhost:7005/mcp

# --- policy ---
PLAN_CONFIDENCE_THRESHOLD=0.6
REVIEW_ESCALATE_SCORE=3
MAX_ITERATIONS=15
DEFAULT_TASK_BUDGET_USD=1.00
TIER1_TTL_HOURS=24

# --- ops ---
API_KEY=change-me
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO

# --- memory (Architecture.md 7) ---
MEMORY_ENABLED=true
MEMORY_COLLECTION=memories
MEMORY_DEDUP_THRESHOLD=0.92
MEMORY_RECALL_K=5
MEMORY_RECALL_KEEP=3
MEMORY_RECALL_MAX_TOKENS=600
MEMORY_HALF_LIFE_DAYS=30
MEMORY_MAX_AGE_DAYS=180

# --- observability + evals (Architecture.md 9, Phases.md 6) ---
JAEGER_QUERY_URL=http://localhost:16686
EVALS_REPORTS_DIR=packages/evals/reports
